# 统一换行与二进制判定，避免 Windows/macOS 检出差异
* text=auto eol=lf

*.py    text
*.md    text
*.json  text
*.toml  text
*.html  text
*.js    text
*.c     text
*.h     text
*.S     text
*.ld    text
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.sh    text eol=lf

*.wav   binary
*.zip   binary
*.pdf   binary
*.pptx  binary
*.png   binary
*.ico   binary
*.onnx  binary
*.mvn   binary
*.tar.gz binary